#!/usr/bin/env bash
# Harness-neutral rule-map gate.
#
# Runs for every commit regardless of who made the change: any agent, any tool,
# or a human in an editor. Catches the silent failure where a rule file exists
# but is named nowhere in AGENTS.md, so it never loads and nothing errors.
#
# Enable once per clone (git does not run hooks from a tracked directory by
# default):
#
#   git config core.hooksPath .githooks
#
# Bypass with `git commit --no-verify` — a deliberate, visible act.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! python3 scripts/check-rule-map.py; then
  echo "" >&2
  echo "pre-commit: BLOCKED — the rule map is inconsistent (see above)." >&2
  exit 1
fi
