#!/usr/bin/env bash
# Run the rule-map gate only when its source inputs are staged.
# Use `.githooks/pre-commit --all` for a deliberate full check.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

run_all=0
if [[ "${1:-}" == "--all" ]]; then
  run_all=1
elif [[ $# -gt 0 ]]; then
  echo "pre-commit: unknown argument: $1" >&2
  exit 2
fi

staged_paths="$(git diff --cached --name-only --diff-filter=ACMRD)"
pattern='^(AGENTS\.md|CLAUDE\.md|ai-rules/.*\.md|scripts/check-rule-map\.py|\.githooks/pre-commit)$'

if [[ $run_all -eq 0 ]] && ! printf '%s\n' "$staged_paths" | grep -Eq "$pattern"; then
  echo "pre-commit: no rule-map inputs staged; no repository gate ran"
  exit 0
fi

if [[ $run_all -eq 0 ]]; then
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if ! git diff --quiet -- "$path"; then
      echo "pre-commit: BLOCKED — rule-map input is only partially staged: $path" >&2
      echo "Stage the complete file or remove it from this commit." >&2
      exit 1
    fi
  done <<< "$(printf '%s\n' "$staged_paths" | grep -E "$pattern" || true)"
fi

if ! python3 scripts/check-rule-map.py; then
  echo "" >&2
  echo "pre-commit: BLOCKED — the rule map is inconsistent (see above)." >&2
  exit 1
fi

echo "pre-commit: rule map passed"
